# Copy to .env and fill in. The real .env is gitignored.
# Every variable here is read exactly once, in src/core/config.py.

# --- Postgres ---------------------------------------------------------------
# Supabase -> Project Settings -> Database -> Connection string -> URI
# This one IS a secret: it contains the postgres password and the role it
# connects as bypasses Row Level Security.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Supabase Auth ----------------------------------------------------------
# Supabase -> Project Settings -> API -> Project URL
# Not a secret. Used to build the JWKS URL and the expected `iss` claim.
SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase -> Project Settings -> API -> anon / publishable key
# Not a secret either — this is the key browsers use.
# Only needed for POST /dev/signin; token verification does not use it.
SUPABASE_ANON_KEY=<anon-key>

# --- Development ------------------------------------------------------------
# Registers POST /dev/signin, which mints a real access token for curl testing
# before the frontend login screen exists. Leave this OFF in production.
ENABLE_DEV_ROUTES=true

# Note there is deliberately NO service role key here. This API verifies
# Supabase JWTs against the public JWKS, so it never needs a key capable of
# minting or forging one.
