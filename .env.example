# Copy to .env and fill in. The real .env is gitignored.
# Every variable here is read exactly once, in src/core/config.py.

# --- Postgres ---------------------------------------------------------------
# Supabase -> Project Settings -> Database -> Connection string -> URI
# This one IS a secret: it contains the postgres password and the role it
# connects as bypasses Row Level Security.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Supabase Auth ----------------------------------------------------------
# Supabase -> Project Settings -> API -> Project URL
# Not a secret. Used to build the JWKS URL and the expected `iss` claim.
SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase -> Project Settings -> API -> anon / publishable key
# Not a secret either — this is the key browsers use.
# Only needed for POST /dev/signin; token verification does not use it.
SUPABASE_ANON_KEY=<anon-key>

# --- Supabase Storage -------------------------------------------------------
# Supabase -> Project Settings -> API -> service_role key
#
# This one IS a secret, and it is the only key of its kind this API holds. It
# bypasses Row Level Security and can read or write anything in the project.
#
# It exists for exactly one reason: signing upload URLs for contributors, who
# have no account and therefore no token of their own. Nothing else uses it,
# and it is confined to src/integrations/supabase_storage.py.
#
# Never log it, never return it in a response, never send it to the browser.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# The private bucket media objects go to. Create it in Supabase -> Storage:
# name it exactly this, mark it Private, and set a 50 MB file size limit.
# A setting rather than a constant so staging and production cannot end up
# writing into the same bucket.
SUPABASE_STORAGE_BUCKET=memoir-media

# --- AssemblyAI (transcription) ---------------------------------------------
# assemblyai.com -> your account -> API key.
#
# A secret, though a much smaller one than the service role key above: it can
# spend money on this account and read the transcripts this account has made,
# and nothing else. Confined to src/integrations/assemblyai.py.
ASSEMBLYAI_API_KEY=<assemblyai-key>

# A string YOU invent. AssemblyAI does not issue this one.
#
# The webhook endpoint is public, because AssemblyAI has no account here and
# can hold no token. So every job is submitted carrying this value in a custom
# header, AssemblyAI echoes it back on the callback, and the endpoint checks it
# matches. That is the whole authentication for POST /webhooks/assemblyai —
# make it long and random.
ASSEMBLYAI_WEBHOOK_SECRET=<any long random string>

# Which model to ask for. Empty means AssemblyAI's default. A setting so a
# cheaper tier can be tried without a deploy.
ASSEMBLYAI_SPEECH_MODEL=

# Where AssemblyAI should POST a finished transcript, e.g.
# https://api.memoirproject.co
#
# LEAVE THIS EMPTY IN LOCAL DEVELOPMENT. localhost is not reachable from the
# internet, so no webhook is requested and the reconcile-on-read path collects
# results instead — which is exactly why that path exists. No tunnel needed.
PUBLIC_BASE_URL=

# The kill switch. False and uploads still work, transcripts are marked
# 'skipped', and nothing is spent.
TRANSCRIPTION_ENABLED=true

# --- Development ------------------------------------------------------------
# Registers POST /dev/signin, which mints a real access token for curl testing
# before the frontend login screen exists. Leave this OFF in production.
ENABLE_DEV_ROUTES=true

# Note on the split above: token *verification* needs no secret at all. The
# project signs with ES256 and publishes a public JWKS, so this API can prove a
# token is genuine while holding nothing capable of forging one. The service
# role key is for storage, not for auth.
